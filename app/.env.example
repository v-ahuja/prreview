DATABASE_URL=postgres://localhost:5432/walkthrough
POSTGRES_PASSWORD=replace-with-a-strong-password
PUBLIC_ORIGIN=http://localhost:3000
PORT=3000
# Bind to 127.0.0.1 for a local-only workspace; 0.0.0.0 behind a deployment proxy.
HOST=127.0.0.1
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_PRIVATE_KEY_BASE64=
GITHUB_WEBHOOK_SECRET=
# 32 random bytes, base64 encoded: openssl rand -base64 32
SESSION_ENCRYPTION_KEY=
# Optional: codex or claude to use an installed CLI's existing login.
# Leave empty to use OpenCode with a provider API key instead.
WALKTHROUGH_RUNNER=
# CLI model name when using a runner; OpenCode provider/model otherwise.
WALKTHROUGH_MODEL=
# Allow explicitly requested walkthroughs and chat. Set false to disable all AI.
GENERATION_ENABLED=true
# Sync never queues walkthroughs by default. Automation also requires a repository opt-in.
AUTOMATIC_GENERATION_ENABLED=false
# Exact comma-separated IDs approved for private code, e.g. codex/gpt-6-astra.
# Empty means public PRs only. Use runner/default if no CLI model is specified.
PRIVATE_ALLOWED_MODELS=
# Restrict a personal workspace to specific GitHub logins. Empty allows any authorized GitHub reader.
ALLOWED_GITHUB_LOGINS=
# Opt in only if the bot should post walkthrough links as GitHub comments.
PUBLISH_WALKTHROUGH_LINKS=false
# Provider credential for the selected model, e.g. OPENAI_API_KEY or GOOGLE_GENERATIVE_AI_API_KEY.
OPENAI_API_KEY=
GOOGLE_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# npm run connected starts both the web app and worker.
# The worker needs git and the selected model CLI.
# The web process uses the same model/provider credential for contextual chat.
# Repository automation requires both generation switches plus a non-manual repository mode.
