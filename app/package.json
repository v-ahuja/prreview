{
  "name": "pr-walkthrough-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "pr-walkthrough": "./bin/pr-walkthrough.js"
  },
  "files": [
    "bin",
    "src",
    "public",
    "README.md",
    "prompts",
    "scripts",
    "client",
    "db",
    "demo",
    "eval"
  ],
  "scripts": {
    "start": "node src/server.js",
    "connected": "node src/connected.js",
    "local": "node bin/pr-walkthrough.js",
    "demo": "node src/demo.js",
    "worker": "node src/worker.js",
    "migrate": "node src/migrate.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "eval": "node eval/run.js",
    "test:ui": "playwright test",
    "build": "node scripts/build-editor.js",
    "postinstall": "npm run build"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "@excalidraw/mermaid-to-excalidraw": "3.1.0",
    "diff": "9.0.0",
    "dompurify": "3.4.17",
    "esbuild": "^0.28.2",
    "highlight.js": "11.12.0",
    "markdown-it": "^14.3.3",
    "mermaid": "12.2.0",
    "monaco-editor": "^0.57.0",
    "opencode-ai": "1.18.32",
    "pg": "^8.23.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1"
  },
  "overrides": {
    "dompurify": "3.4.17",
    "lodash-es": "4.18.1",
    "nanoid": "5.1.16",
    "katex": "0.19.1",
    "@excalidraw/mermaid-to-excalidraw": "$@excalidraw/mermaid-to-excalidraw"
  }
}
